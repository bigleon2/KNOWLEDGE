generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// LEON TSI EDITEUR v11 (Extension React du studio v11 — Task 40)
// Un projet = un mapping TSI complet (JSON : device + mappings scellé).
model Project {
  id        String    @id @default(cuid())
  name      String
  data      String    // JSON { device, mappings } — source de vérité du mapping
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  audits    AuditLog[]
}

// Journal d'audit auto-évolutif du studio v11 (architecture-mapping-studio-v11.md) :
// chaque action (preset, DSL, génération, correctif) y laisse une entrée horodatée
// qui alimente l'itération suivante — jamais effacé, uniquement croissant.
model AuditLog {
  id        String   @id @default(cuid())
  projectId String
  action    String
  detail    String   @default("")
  mappings  Int      @default(0)
  conflits  Int      @default(0)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}
